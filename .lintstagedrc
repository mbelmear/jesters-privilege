{
  "*": "prettier --ignore-unknown --write",
  ".github/workflows/*.{yml,yaml}": [
    "scripts/actionlint.sh",
    "scripts/zizmor.sh --offline --no-progress"
  ],
  ".github/actions/**/*.{yml,yaml}": "scripts/zizmor.sh --offline --no-progress",
  "scripts/*.sh": "scripts/shellcheck.sh --severity=warning"
}
