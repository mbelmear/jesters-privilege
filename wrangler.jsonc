// Cloudflare Workers config: one Worker serving the static export in out/.
// Deployed by .github/workflows/deploy.yml; see docs/deploy.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jesters-privilege",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every request reaches the Worker first so it can redirect www.
    "run_worker_first": true,
  },
  "routes": [
    { "pattern": "jestersprivilegepodcast.com", "custom_domain": true },
    { "pattern": "www.jestersprivilegepodcast.com", "custom_domain": true },
  ],
  // Submit emails go only to the show's inbox (src/worker/adapters.ts).
  // TURNSTILE_SECRET_KEY is a Worker secret, uploaded by the deploy workflow.
  "send_email": [
    {
      "name": "SUBMISSION_EMAIL",
      "destination_address": "hello@jestersprivilegepodcast.com",
    },
  ],
  // workers.dev must stay on for per-PR preview URLs.
  "workers_dev": true,
  "preview_urls": true,
}
