{
  "name": "jesters-privilege",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run images && npm run snapshot && next dev",
    "build": "npm run images && npm run snapshot && next build",
    "images": "tsx scripts/images.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "transcribe": "tsx scripts/transcribe.ts",
    "add-painting": "tsx scripts/add-painting.ts",
    "start": "next start",
    "lint": "next typegen && eslint",
    "lint:workflows": "scripts/actionlint.sh",
    "lint:shell": "scripts/lint-shell.sh scripts/*.sh",
    "lint:actions": "tsx scripts/shellcheck-actions.ts .github/actions",
    "lint:zizmor": "scripts/zizmor.sh --offline --no-progress .github",
    "prepare": "husky",
    "typecheck": "next typegen && tsc --noEmit",
    "test": ". scripts/pinned-node.sh && jest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:watch": ". scripts/pinned-node.sh && jest --watch",
    "test:coverage": ". scripts/pinned-node.sh && jest --coverage",
    "test:e2e": "playwright test --project='chromium-*' --project='webkit-*'",
    "test:e2e:firefox": "playwright test --project='firefox-*'",
    "build:empty-feed": "FEED=empty npm run build",
    "test:e2e:empty-feed": "FEED=empty playwright test --project='chromium-*' --project='webkit-*'",
    "lighthouse": "scripts/lighthouse.sh",
    "lighthouse:compare": "scripts/lighthouse-compare.sh",
    "lighthouse:spread": "scripts/lighthouse-spread.sh",
    "screenshots": "tsx scripts/screenshots.ts",
    "screenshots:compare": "tsx scripts/screenshots-compare.ts",
    "compiled-classes": "tsx scripts/compiled-classes.ts",
    "trace": "tsx scripts/trace-summary.ts",
    "ci-times": "tsx scripts/ci-times.ts",
    "test-times": "tsx scripts/test-times.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mark-ready": "tsx scripts/mark-ready.ts",
    "review-passed": "tsx scripts/review-passed.ts",
    "ready": "scripts/ready-tickets.sh",
    "worktree": "scripts/fetch.sh --quiet origin && bash -c \"$(git show origin/main:scripts/new-worktree.sh)\" new-worktree",
    "worktree-done": "scripts/worktree-done.sh",
    "launch-check": "FEED=live tsx scripts/launch-check.ts",
    "feed-check": "tsx scripts/feed-check.ts",
    "email-destination": "tsx scripts/email-destination.ts",
    "try-feed": "tsx scripts/try-feed.ts",
    "pr-status": "tsx scripts/pr-status.ts",
    "fonts": "tsx scripts/fonts.ts",
    "report-nightly": "tsx scripts/report-nightly.ts",
    "report-deploy": "tsx scripts/report-deploy.ts",
    "dropped-tests": "tsx scripts/dropped-tests.ts",
    "email-routing-check": "tsx scripts/email-routing-check.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.64.0",
    "motion": "^14.7.1",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "simple-icons": "^16.36.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "harfbuzzjs": "^1.6.4",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "json5": "^2.2.3",
    "lint-staged": "^17.6.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0",
    "wrangler": "^4.155.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "compression": "^1.8.2",
    "basic-ftp": "^6.2.6",
    "minimatch@^9": "^11.0.9",
    "minimatch@^10": "^11.0.9",
    "glob@^10": "^14.0.3",
    "glob@^13": "^14.0.3"
  }
}
